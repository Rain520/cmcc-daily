# Initial admin password, at least 6 characters. Leave empty to start with 123456;
# change it in the web UI afterwards (the stored password wins over this value).
# Use single quotes to keep $ and # literal in Docker Compose.
CMCC_WEB_PASSWORD=''

# Default: only this machine can reach the dashboard.
# For a LAN server / NAS, set its LAN IP or 0.0.0.0.
CMCC_BIND_ADDRESS=127.0.0.1
CMCC_WEB_PORT=8080
TZ=Asia/Shanghai

# Container runtime user/group; startup initializes data permissions automatically.
PUID=10001
PGID=10001
# Octal mask for new files; credential JSON files always stay owner-only.
UMASK=077

# Maximum runtime of a task in seconds; history retention in days.
CMCC_TASK_TIMEOUT=3600
CMCC_RETENTION_DAYS=30

# Set true when accessing through an HTTPS reverse proxy.
CMCC_SECURE_COOKIE=false
